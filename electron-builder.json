{
  "appId": "kz.qala.desktop",
  "productName": "QALA",
  "directories": {
    "output": "release-exe"
  },
  "files": [
    "dist/**/*",
    "electron/main.cjs"
  ],
  "extraMetadata": {
    "main": "electron/main.cjs"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "public/pwa-512x512.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "shortcutName": "QALA"
  }
}
